# 忽略特定文件
secret.txt
temp.log
password.txt


# 忽略整个文件夹（及其所有内容）
node_modules/
__pycache__/
.idea/
.vscode/

# 忽略所有 .tmp 结尾的文件
*.tmp

# 忽略以 ~ 结尾的备份文件
*~

# 忽略系统文件（Windows）
Thumbs.db
desktop.ini

# Python 编译缓存与虚拟环境
*.pyc
*.pyo
.venv/
venv/
.env

# 打包构建产物（可用 README 中的命令重新生成）
build/
dist/

# 游戏存档与运行日志（用户本地数据）
highscore.txt
error.log
debug.log

# 系统文件（macOS）
.DS_Store

# ===== 生成/产物文件（仅提交代码，以下一律不提交）=====
